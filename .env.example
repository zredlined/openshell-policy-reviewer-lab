LAB_OPENSHELL_GATEWAY=http://127.0.0.1:8080
# OPENSHELL_TOKEN=
# OPENSHELL_CA_CERT=
# OPENSHELL_CLIENT_CERT=
# OPENSHELL_CLIENT_KEY=

LAB_GITHUB_OWNER=
LAB_GITHUB_REPO=openshell-policy-reviewer-canary
LAB_GITHUB_BRANCH=main
LAB_GITHUB_TOKEN=
# Set NVIDIA_API_KEY directly, or point at a private env file containing
# NVIDIA_API_KEY or OPENAI_API_KEY.
NVIDIA_ENV_FILE=

LAB_DURATION_MINUTES=30
LAB_REVIEW_GRACE_SECONDS=90
LAB_KEEP_SANDBOX=0
LAB_SANDBOX_IMAGE=openshell-policy-reviewer-lab/codex:0.147.0-tools1
LAB_MODEL=openai/openai/gpt-5.6-sol
LAB_REASONING=high
NVIDIA_RESPONSES_URL=https://inference-api.nvidia.com/v1/responses

# Scale mode: fresh reviewer context per campaign, persistent context within it.
LAB_RUNS=10
LAB_CONCURRENCY=2
