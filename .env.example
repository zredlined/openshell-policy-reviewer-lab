LAB_OPENSHELL_GATEWAY=http://127.0.0.1:8080
# OPENSHELL_TOKEN=
# OPENSHELL_CA_CERT=
# OPENSHELL_CLIENT_CERT=
# OPENSHELL_CLIENT_KEY=

LAB_GITHUB_OWNER=
LAB_GITHUB_REPO=openshell-policy-reviewer-canary
LAB_GITHUB_BRANCH=main
LAB_GITHUB_TOKEN=
# Defaults to ~/.codex/auth.json when omitted.
# LAB_CODEX_AUTH_FILE=/home/you/.codex/auth.json

LAB_MAX_DECISIONS=20
LAB_DURATION_MINUTES=30
LAB_REVIEW_SETTLE_SECONDS=90
LAB_KEEP_SANDBOX=0
# LAB_REVIEWER_MODEL=
LAB_CHALLENGER_MODEL=gpt-5.4-mini
LAB_CHALLENGER_REASONING=medium

# Scale mode: fresh reviewer context per campaign, persistent context within it.
LAB_RUNS=10
LAB_CONCURRENCY=2
